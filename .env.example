# Django secret key. Required when DEBUG is not True.
# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Debug mode is disabled unless DEBUG=True. Never enable it in production.
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave SENTRY_DSN empty to disable Sentry locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
